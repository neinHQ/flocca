# Separate database/schema credentials from the existing extension service.
VISIBILITY_DATABASE_URL=postgresql://visibility:replace_me@localhost:5432/flocca_visibility
VISIBILITY_PUBLIC_ORIGIN=http://localhost:4100
PORT=4100
HOST=127.0.0.1
NODE_ENV=development
# Generate with: openssl rand -hex 32. Keep this stable and back it up securely.
VISIBILITY_EVIDENCE_KEY=
VISIBILITY_RENDER=true
# Used only by the bootstrap CLI. Remove password from environment after use.
VISIBILITY_ADMIN_EMAIL=
VISIBILITY_ADMIN_PASSWORD=
VISIBILITY_TENANT_NAME=
VISIBILITY_MONTHLY_CAP_USD=0
# Both adapters remain disabled until all fields are explicitly configured.
# Select an account-available search-capable model; no model silently substituted.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TERMS_APPROVED=false
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_SEARCH_USD_PER_CALL=
OPENAI_MAX_EXECUTION_USD=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
PERPLEXITY_TERMS_APPROVED=false
PERPLEXITY_INPUT_USD_PER_MILLION=
PERPLEXITY_OUTPUT_USD_PER_MILLION=
PERPLEXITY_SEARCH_USD_PER_CALL=
PERPLEXITY_MAX_EXECUTION_USD=
