# Separate database/schema credentials from the existing extension service.
VISIBILITY_DATABASE_URL=postgresql://visibility:replace_me@localhost:5432/flocca_visibility
VISIBILITY_PUBLIC_ORIGIN=http://localhost:4100
PORT=4100
HOST=127.0.0.1
NODE_ENV=development
# Generate with: openssl rand -hex 32. Keep this stable and back it up securely.
VISIBILITY_EVIDENCE_KEY=
VISIBILITY_RENDER=true
# Used only by the bootstrap CLI. Remove password from environment after use.
VISIBILITY_ADMIN_EMAIL=
VISIBILITY_ADMIN_PASSWORD=
VISIBILITY_TENANT_NAME=
VISIBILITY_MONTHLY_CAP_USD=0
# All adapters remain disabled until all fields are explicitly configured.
# Select an account-available search-capable model; no model silently substituted.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TERMS_APPROVED=false
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_SEARCH_USD_PER_CALL=
OPENAI_MAX_EXECUTION_USD=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
PERPLEXITY_TERMS_APPROVED=false
PERPLEXITY_INPUT_USD_PER_MILLION=
PERPLEXITY_OUTPUT_USD_PER_MILLION=
PERPLEXITY_SEARCH_USD_PER_CALL=
PERPLEXITY_MAX_EXECUTION_USD=
# Phase 2: adapters remain unavailable until access, terms and rates are configured.
CLAUDE_API_KEY=
CLAUDE_MODEL=
CLAUDE_TERMS_APPROVED=false
CLAUDE_INPUT_USD_PER_MILLION=
CLAUDE_OUTPUT_USD_PER_MILLION=
CLAUDE_SEARCH_USD_PER_CALL=
CLAUDE_MAX_EXECUTION_USD=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TERMS_APPROVED=false
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
GEMINI_SEARCH_USD_PER_CALL=
GEMINI_MAX_EXECUTION_USD=
# Reservation allowance only: Gemini exposes no hard search-query cap here.
GEMINI_SEARCH_RESERVE_CALLS=
GROK_API_KEY=
GROK_MODEL=
GROK_TERMS_APPROVED=false
GROK_INPUT_USD_PER_MILLION=
GROK_OUTPUT_USD_PER_MILLION=
GROK_SEARCH_USD_PER_CALL=
GROK_MAX_EXECUTION_USD=
META_API_KEY=
META_MODEL=
META_TERMS_APPROVED=false
META_INPUT_USD_PER_MILLION=
META_OUTPUT_USD_PER_MILLION=
META_SEARCH_USD_PER_CALL=
META_MAX_EXECUTION_USD=
